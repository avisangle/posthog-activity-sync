  "license": "MIT",
  "description": "PostHog product activity for Twenty CRM: shows each person's recent events and sessions from PostHog on their People record.",
  "author": "Avinash Sangle (https://github.com/avisangle)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avisangle/posthog-activity-sync.git"
  },
  "homepage": "https://github.com/avisangle/posthog-activity-sync#readme",
  "bugs": "https://github.com/avisangle/posthog-activity-sync/issues",
  "engines": {
    "node": "^24.5.0 || ^26.5.1",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "twenty": ">=2.49.0"
  },
  "keywords": [
    "twenty-app",
    "twenty",
    "crm",
    "posthog",
    "analytics"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
